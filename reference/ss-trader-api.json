{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "SSTrader API"
  },
  "servers": [
    {
      "url": "https://api.sstrader.com/v1"
    }
  ],
  "tags": [
    {
      "name": "Fixtures"
    },
    {
      "name": "Regions"
    }
  ],
  "paths": {
    "/regions": {
      "get": {
        "tags": [
          "Regions"
        ],
        "summary": "Get all regions, countries and leagues",
        "operationId": "getRegions",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "all"
              ],
              "default": "upcoming"
            }
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "es",
                "bg"
              ],
              "default": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of regions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegionsResponse"
                },
                "example": {
                  "regions": [
                    {
                      "region": {
                        "id": 6,
                        "name": "International"
                      },
                      "country": {
                        "id": 244,
                        "name": "Africa",
                        "alpha3": ""
                      },
                      "league": {
                        "id": 381,
                        "name": "CAF Champions League",
                        "level": 1
                      },
                      "sport": {
                        "id": 1,
                        "name": "Football"
                      },
                      "count": 8,
                      "live": 0,
                      "popular": false,
                      "level": 3
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/fixtures": {
      "get": {
        "tags": [
          "Fixtures"
        ],
        "summary": "Get fixtures with participants, scores and periods",
        "operationId": "getFixtures",
        "parameters": [
          {
            "in": "query",
            "name": "sport_id",
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "league_id",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "date",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "is_live",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of fixtures",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FixturesResponse"
                },
                "example": {
                  "fixtures": [
                    {
                      "id": 123,
                      "date_time": "2024-10-25T19:45:00.000Z",
                      "status": "INPLAY_1ST_HALF",
                      "is_live": true,
                      "participants": [
                        {
                          "id": 1,
                          "name": "Man Utd",
                          "position": 5,
                          "location": "home"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RegionsResponse": {
        "type": "object",
        "properties": {
          "regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegionItem"
            }
          }
        }
      },
      "RegionItem": {
        "type": "object",
        "properties": {
          "region": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "country": {
            "$ref": "#/components/schemas/Country"
          },
          "league": {
            "$ref": "#/components/schemas/League"
          },
          "sport": {
            "$ref": "#/components/schemas/Sport"
          },
          "count": {
            "type": "integer"
          },
          "live": {
            "type": "integer"
          },
          "popular": {
            "type": "boolean"
          },
          "level": {
            "type": "integer"
          }
        }
      },
      "Sport": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Country": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "alpha3": {
            "type": "string"
          }
        }
      },
      "League": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          }
        }
      },
      "Season": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Participant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "date_time": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "is_live": {
            "type": "boolean"
          },
          "sport": {
            "$ref": "#/components/schemas/Sport"
          },
          "country": {
            "$ref": "#/components/schemas/Country"
          },
          "league": {
            "$ref": "#/components/schemas/League"
          },
          "participants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Participant"
            }
          }
        }
      },
      "FixturesResponse": {
        "type": "object",
        "properties": {
          "fixtures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Fixture"
            }
          }
        }
      }
    }
  }
}