{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "SSTrader API"
  },
  "servers": [
    {
      "url": "https://api.sstrader.com/v1"
    }
  ],
  "tags": [],
  "paths": {
    "/regions": {
      "get": {
        "description": "Returns a list of regions, countries, and leagues.",
        "responses": {
          "200": {
            "description": "A list of regions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "regions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "region": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "country": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              },
                              "alpha3": {
                                "type": "string",
                                "description": "ISO Alpha-3 country code"
                              }
                            }
                          },
                          "league": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "sport": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "integer"
                              },
                              "name": {
                                "type": "string"
                              }
                            }
                          },
                          "count": {
                            "type": "integer",
                            "description": "Number of upcoming fixtures in this league."
                          },
                          "live": {
                            "type": "integer",
                            "description": "Number of live fixtures in this league."
                          },
                          "popular": {
                            "type": "boolean",
                            "description": "Whether this league is marked as popular."
                          },
                          "level": {
                            "type": "integer",
                            "description": "League level (1 = top tier, 2 = second tier, etc.)"
                          }
                        }
                      }
                    }
                  },
                  "required": [
                    "regions"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "all"
              ],
              "default": "upcoming"
            },
            "description": "Filter leagues by their status (optional). Possible values: 'upcoming' — leagues with upcoming fixtures; 'all' — leagues that are covered by us. If omitted, all leagues are returned."
          },
          {
            "in": "query",
            "name": "language",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "es",
                "bg"
              ],
              "default": "en"
            },
            "description": "Language for the response (default: English)"
          }
        ],
        "operationId": "get_regions",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-readme": {
          "code-samples": [
            {
              "code": "{\n  \"regions\": [\n    {\n      \"region\": {\n        \"id\": 6,\n        \"name\": \"International\"\n      },\n      \"country\": {\n        \"id\": 244,\n        \"name\": \"Africa\",\n        \"alpha3\": \"\" \n      },\n      \"league\": {\n        \"id\": 381,\n        \"name\": \"CAF Champions League\"\n      },\n      \"sport\": {\n        \"id\": 1,\n        \"name\": \"Football\"\n      },\n      \"count\": 8,\n      \"live\": 0,\n      \"popular\": false,\n      \"level\": 3\n    }\n  ]\n}",
              "language": "json",
              "name": ""
            }
          ],
          "samples-languages": [
            "json"
          ]
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "x-readme": {
    "explorer-enabled": true,
    "proxy-enabled": true
  },
  "security": [
    {
      "BearerAuth": []
    }
  ]
}